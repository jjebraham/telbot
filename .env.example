# Required
MAIN_BOT_TOKEN=123456:your-main-bot-token     # user-facing bot, from @BotFather
ADMIN_BOT_TOKEN=654321:your-admin-bot-token   # bot that posts KYC submissions to admins
ADMIN_CHAT_ID=0                               # Telegram chat ID that receives admin alerts

# Optional
MINIAPP_URL=https://example.com/miniapp       # Telegram Mini App (must be HTTPS)
EHRAZ_TOKEN=                                  # Ehraz identity-matching API; registration fails without it
EHRAZ_MOCK=true                               # demo only: simulate a successful match (no API call)
WALLEX_API_KEY=                               # enables the Wallex /markets price fallback
DB_PATH=./users.db                            # SQLite file, created on first run

# Optional outbound proxy for price APIs (credentials are masked in logs)
PROXY_URL=
PROXY_URLS=                                   # comma-separated pool
PROXY_PATTERN=                                # e.g. http://user-{{i}}:pass@host:port
PROXY_POOL_SIZE=0
